{
  "name": "file-studio-kh",
  "version": "0.6.2",
  "description": "A local-first desktop app for safely organizing messy media folders.",
  "main": "dist-electron/index.js",
  "type": "module",
  "scripts": {
    "dev": "ELECTRON_ENABLE_LOGGING=1 vite",
    "postinstall": "node scripts/ensure-electron.mjs && electron-builder install-app-deps",
    "rebuild:native": "electron-builder install-app-deps",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node test/build.mjs && node test/run.mjs",
    "gate": "bash packaging/gate.sh",
    "dist": "bash packaging/build-dmg.sh",
    "build:mac:arm64": "npm run build && electron-builder --mac dmg --arm64",
    "build:mac": "npm run build && electron-builder --mac dmg"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "better-sqlite3": "^12.10.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.22",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-electron": "^0.29.0"
  },
  "build": {
    "appId": "kh.filestudio.app",
    "productName": "File Studio KH",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "dist-renderer",
      "dist-electron",
      "package.json",
      "README.md",
      "ABOUT.md",
      "CHANGELOG.md",
      "ACCEPTANCE.md"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": "KH Studio Local Signing",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    }
  },
  "allowScripts": {
    "electron": true,
    "better-sqlite3": true,
    "sharp": true,
    "esbuild": true
  }
}
