<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The shim links Sparkle.framework, which is signed separately from this app; the hardened
       runtime's library validation would refuse to load it. Required before Sparkle integration
       (Developer - Utilities, 2026-11-23). -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
